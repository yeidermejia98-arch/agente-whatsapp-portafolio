    {
      "id": "s3",
      "name": "Rango: últimos 90 días",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "jsCode": "// Procesos vigentes = facturas de los últimos 90 días (regla del CEA).\nconst sesion = $input.first().json;\nif (!sesion.accessToken || !sesion.user) {\n  throw new Error('NissiX no devolvió sesión (¿cambió el usuario o la contraseña?)');\n}\nif (sesion.user.estado && sesion.user.estado !== 'activo') {\n  throw new Error('El usuario de NissiX está inactivo');\n}\nconst dia = (d) => d.toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });\nconst hoy = new Date();\nreturn [{ json: {\n  usuario: encodeURIComponent(sesion.user.name),\n  desde: dia(new Date(hoy.getTime() - 90 * 24 * 3600 * 1000)),\n  hasta: dia(hoy),\n} }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "s4",
      "name": "Facturas del periodo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "=https://nissixapp.transitodatos.com/nissix-server/public/api/auth/facturas/fechas/{{ $json.usuario }}/{{ $json.desde }}/{{ $json.hasta }}/18",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Iniciar sesión en NissiX').first().json.accessToken }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "s5",
      "name": "Una por factura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "jsCode": "// NissiX responde una lista de facturas (o 0 si no hay). Deja una por ítem, sin repetir.\nconst vistas = new Set();\nconst salida = [];\nfor (const item of $input.all()) {\n  const lista = Array.isArray(item.json) ? item.json : (item.json.data ?? [item.json]);\n  for (const f of lista) {\n    const numero = f && f.numero_factura;\n    if (!numero || vistas.has(numero)) continue;\n    vistas.add(numero);\n    salida.push({ json: { numero_factura: numero } });\n  }\n}\nif (!salida.length) throw new Error('NissiX no devolvió facturas para el periodo (¿el usuario ve todas las facturas?)');\nreturn salida;"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "s6",
      "name": "Detalle de cada factura",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "=https://nissixapp.transitodatos.com/nissix-server/public/api/auth/detalles_factura/{{ encodeURIComponent($json.numero_factura) }}/18",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Iniciar sesión en NissiX').first().json.accessToken }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          }
        }
      }
    },
    {
      "id": "s7",
      "name": "Armar alumnos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ],
      "parameters": {
        "jsCode": "// Mismas reglas del importador del panel (panel/excel.js): un alumno por cédula,\n// saldo de NissiX, teléfono en formato WhatsApp (57 + 10 dígitos).\nconst pesos = (v) => {\n  if (typeof v === 'number') return Math.round(v);\n  const t = String(v ?? '').replace(/[^\\d,.-]/g, '');\n  if (!t) return null;\n  const n = Number(t.replace(/\\./g, '').replace(',', '.'));\n  return Number.isFinite(n) ? Math.round(n) : null;\n};\nconst categoria = (tramite) => {\n  const texto = String(tramite ?? '');\n  const cea = texto.match(/CEA:(.*?)(CRC:|$)/is)?.[1] ?? texto;\n  const cats = cea.match(/\\b[ABC]\\s?[1-3]\\b/gi) ?? [];\n  const unicas = [...new Set(cats.map((c) => c.replace(/\\s/g, '').toUpperCase()))];\n  return unicas.length ? unicas.join(' + ') : null;\n};\nconst telefono = (t) => {\n  const d = String(t ?? '').replace(/\\D/g, '');\n  const n = d.length === 10 && d.startsWith('3') ? '57' + d : d;\n  return /^573\\d{9}$/.test(n) ? n : null;\n};\n\n// NissiX devuelve el detalle con UNA FILA POR SERVICIO (p. ej. una para C1 y otra para A2),\n// y n8n parte la lista en varios ítems. Se juntan todas las filas de cada factura:\n// los datos del cliente y el saldo se toman de la primera; las categorías, de todas.\nconst detalles = new Map();\nfor (const item of $input.all()) {\n  const lista = Array.isArray(item.json) ? item.json : [item.json];\n  for (const f of lista) {\n    if (!f || !f.numero_factura) continue;\n    const previa = detalles.get(f.numero_factura);\n    const texto = [f.tramite, f.categoria, f.servicio].filter(Boolean).join(' ');\n    if (previa) previa._tramites.push(texto);\n    else detalles.set(f.numero_factura, { ...f, _tramites: [texto] });\n  }\n}\nconst avisos = [];\nconst pedidas = $('Una por factura').all().map((i) => i.json.numero_factura);\nconst faltan = pedidas.filter((n) => !detalles.has(n));\nif (faltan.length) avisos.push(`sin detalle: ${faltan.join(', ')}`);\n\nconst porCedula = new Map();\nlet facturas = 0;\nfor (const f of detalles.values()) {\n  if (/anulad/i.test(String(f.estado_factura ?? ''))) continue;\n  const cats = [...new Set(f._tramites.flatMap((t) => (categoria(t) ?? '').split(' + ').filter(Boolean)))];\n  const cat = cats.length ? cats.join(' + ') : null;\n  if (!cat) continue; // no es curso de conducción (p. ej. solo exámenes CRC)\n  facturas++;\n  const cedula = String(f.cedula_cliente ?? '').replace(/[\\s.]/g, '');\n  if (!cedula) { avisos.push(`${f.numero_factura}: sin cédula`); continue; }\n  const tel = telefono(f.telefono_cliente);\n  if (!tel) avisos.push(`${f.numero_factura}: teléfono no válido`);\n  const fila = {\n    documento: cedula,\n    nombre: String(f.nombre_cliente ?? '').replace(/\\s+/g, ' ').trim(),\n    categoria: cat,\n    valor: pesos(f.valor_total_factura) ?? 0,\n    saldo: Math.max(pesos(f.saldo_pendiente) ?? 0, 0),\n    telefono: tel,\n  };\n  const previa = porCedula.get(cedula);\n  if (previa) {\n    previa.valor += fila.valor;\n    previa.saldo += fila.saldo;\n    previa.categoria = [...new Set(`${previa.categoria} + ${fila.categoria}`.split(' + '))].join(' + ');\n    previa.telefono = previa.telefono ?? fila.telefono;\n  } else {\n    porCedula.set(cedula, fila);\n  }\n}\nif (!porCedula.size) throw new Error('No quedó ningún alumno para importar: revisar la respuesta de NissiX');\nreturn [{ json: { filas: [...porCedula.values()], facturas, avisos: avisos.join('; ').slice(0, 1500) } }];\n"
      },
      "onError": "continueErrorOutput"
    },
