    {
      "id": "e1",
      "name": "Describir error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        160
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json.error ?? $input.first().json;\nconst texto = typeof e === 'string' ? e : (e.message ?? JSON.stringify(e));\n// Nunca guardar el token ni la contraseña: solo el mensaje\nreturn [{ json: { detalle: String(texto).replace(/Bearer\\s+\\S+/gi, 'Bearer ***').slice(0, 500) } }];"
      }
