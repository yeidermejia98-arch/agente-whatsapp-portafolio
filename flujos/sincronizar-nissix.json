        "operation": "executeQuery",
        "query": "insert into public.sincronizaciones (ok, facturas, creados, actualizados, sin_telefono, detalle, motivo) values (true, $1, $2, $3, $4, nullif($5, ''), $6);",
        "options": {
          "queryReplacement": "={{ [\n  $('Armar alumnos').first().json.facturas,\n  $json.creados ?? 0,\n  $json.actualizados ?? 0,\n  $json.sin_telefono ?? 0,\n  $('Armar alumnos').first().json.avisos,\n  ($('Motivo: botón del panel').isExecuted ? 'botón del panel' : $('Motivo: antes del cobro').isExecuted ? 'antes del cobro' : $('Motivo: domingo').isExecuted ? 'domingo' : 'prueba manual')\n] }}"
