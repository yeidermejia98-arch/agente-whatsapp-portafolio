{
  "id": "RecSaldosCEA0001",
  "name": "Recordatorio de saldos (12 m.: cada 8 días, 15 y 30)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "nodes": [
    {
      "id": "c9a2d3b1-0002-4d2b-8b02-000000000001",
      "name": "Todos los días 12 m.",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 12
            }
          ]
        }
      }
    },
    {
      "id": "c9a2d3b1-0002-4d2b-8b02-000000000002",
      "name": "Alumnos con saldo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from public.saldos_para_hoy();",
        "options": {}
      }
    },
    {
      "id": "c9a2d3b1-0002-4d2b-8b02-000000000003",
      "name": "Enviar saldo por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API_URL }}/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  messaging_product: 'whatsapp',\n  to: $json.telefono,\n  type: 'template',\n  template: {\n    name: 'recordatorio_saldo',\n    language: { code: 'es' },\n    components: [{\n      type: 'body',\n      parameters: [\n        { type: 'text', text: $json.nombre },\n        { type: 'text', text: $json.saldo }\n      ]\n    }]\n  }\n}) }}",
        "options": {}
      }
    },
    {
      "id": "c9a2d3b1-0002-4d2b-8b02-000000000004",
      "name": "Registrar envío",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.registrar_recordatorio_saldo($1, $2, $3, $4);",
        "options": {
          "queryReplacement": "={{ [\n  $('Alumnos con saldo').item.json.alumno_id,\n  !!($json.messages && $json.messages[0]),\n  ($json.messages && $json.messages[0]) ? $json.messages[0].id : '',\n  $json.error ? JSON.stringify($json.error).slice(0, 500) : ''\n] }}"
        }
      }
    }
  ],
  "connections": {
    "Alumnos con saldo": {
      "main": [
        [
          {
            "node": "Enviar saldo por WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar saldo por WhatsApp": {
      "main": [
        [
          {
            "node": "Registrar envío",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Todos los días 12 m.": {
      "main": [
        [
          {
            "node": "Alumnos con saldo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
